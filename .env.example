# Local process settings. No credentials are required to inspect health.
HOST=127.0.0.1
PORT=3001
# Optional connection when running with npm instead of Compose.
# DATABASE_URL=postgresql://user:password@localhost:5432/mindspace

# Host port for Docker Compose
API_PORT=3001

# Explicit local, redacted aggregate data only; requires DATABASE_URL. Keep the API on loopback.
# DASHBOARD_LOCAL_AGGREGATES=1
# DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional synthetic PostgreSQL dashboard fixture endpoint; requires the settings above.
# DASHBOARD_DEMO=1
# For the DB demo preview also allow http://127.0.0.1:5175,http://localhost:5175
