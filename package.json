{
  "name": "mind-space-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MindSpace standalone backend foundation; endpoints deferred",
  "type": "commonjs",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts eslint.config.cjs",
    "check": "npm run typecheck && npm run lint",
    "test": "npm run build && node --test dist/__tests__/*.test.js",
    "test:backend": "npm test",
    "smoke": "npm run build && node dist/local-smoke.js",
    "smoke:dashboard": "node scripts/dashboard-smoke.cjs",
    "sync:contract": "node scripts/sync-mobile-contract.cjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && npm start",
    "test:postgres": "npm run build && node --test dist/integration/*.test.js",
    "seed:dashboard": "npm run build && node --env-file-if-exists=.env dist/dashboard/seed-demo.js",
    "smoke:dashboard-demo": "node scripts/dashboard-demo-smoke.cjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.4",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  }
}
